# Never expose Git data if the folder is a Git checkout
RedirectMatch 404 /\.git

# Compress text files so pages load faster
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  # The page itself: always check for a new version
  ExpiresByType text/html "access plus 0 seconds"
  # CSS, JS and fonts get a new file name whenever they change, so a long cache is safe
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # Photos and icons keep the same name, so cache them for one month only
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Force HTTPS: leave commented out until SSL works on your domain (see step 5, then Step 17)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]